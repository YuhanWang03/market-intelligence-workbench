[Unit]
Description=AI Hedge Fund Workbench (Vinext)
After=network-online.target hedge-fund-web.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/market-intelligence-workbench/ai-workbench
Environment="NODE_ENV=production"
Environment="PORT=3000"
ExecStart=/usr/bin/npm run start -- --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=10
StandardOutput=append:/root/market-intelligence-workbench/logs/workbench.log
StandardError=append:/root/market-intelligence-workbench/logs/workbench.err

[Install]
WantedBy=multi-user.target
