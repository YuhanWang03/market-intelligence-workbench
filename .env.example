# Web access control. Generate long random values for production and never
# commit the resulting .env file. Until WEB_ADMIN_PASSWORD_HASH is configured,
# WEB_OWNER_TOKEN is also accepted as the owner's initial browser password.
WEB_OWNER_TOKEN=replace-with-a-long-random-service-token
WEB_ADMIN_USERNAME=owner
WEB_ADMIN_PASSWORD_HASH=
WEB_SESSION_SECRET=replace-with-a-separate-long-random-session-secret
WEB_SESSION_TTL_SECONDS=28800
WEB_GUEST_ENABLED=true
# Change to true only after HTTPS is enabled.
WEB_COOKIE_SECURE=false
WEB_PUBLIC_SNAPSHOT_DB=data/public_snapshots.db

# For getting financial data to power the hedge fund
# Get your Financial Datasets API key from https://financialdatasets.ai/
FINANCIAL_DATASETS_API_KEY=your-financial-datasets-api-key

# Optional web/news research. Guest requests never call this provider.
TAVILY_API_KEY=your-tavily-api-key

# For running LLMs hosted by openai (GPT 5, etc.)
# Get your OpenAI API key from https://platform.openai.com/
OPENAI_API_KEY=your-openai-api-key

# For running LLMs hosted by anthropic (claude-4-sonnet, claude-4.1-opus, etc.)
# Get your Anthropic API key from https://anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key

# For running LLMs hosted by deepseek (deepseek-chat, deepseek-reasoner, etc.)
# Get your DeepSeek API key from https://deepseek.com/
DEEPSEEK_API_KEY=your-deepseek-api-key

# For running LLMs hosted by groq (deepseek, llama3, etc.)
# Get your Groq API key from https://groq.com/
GROQ_API_KEY=your-groq-api-key

# For running LLMs hosted by gemini (gemini-2.5-flash, gemini-2.5-pro)
# Get your Google API key from https://ai.dev/
GOOGLE_API_KEY=your-google-api-key

# For running LLMs hosted by xAI (Grok 4, etc.)
XAI_API_KEY=your-xai-api-key

# For running LLMs hosted by Moonshot / Kimi (kimi-k2, kimi-latest, moonshot-v1-*)
# Get your Moonshot API key from https://platform.moonshot.ai/
# Mainland China users: set MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_API_KEY=your-moonshot-api-key

# For running LLM GigaChat
GIGACHAT_API_KEY=your-gigachat-api-key

# For running LLMs hosted by OpenRouter
OPENROUTER_API_KEY=your-openrouter-api-key

# For running LLMs hosted by Microsoft Azure OpenAI (gpt-4o, gpt-4o-mini, etc.)
# Get your Azure OpenAI API settings from https://oai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_ENDPOINT=your-azure-openai-endpoint
AZURE_OPENAI_DEPLOYMENT_NAME=your-azure-openai-deployment-name

# SEC EDGAR requires a descriptive User-Agent with a contact email.
EDGAR_IDENTITY=Your Name your-email@example.com

# ---------------------------------------------------------------------------
# Agents. Both agents read the shared AGENT_LLM_* trio; V3 prefers AGENT_V3_*
# when set (its production service falls back to the AGENT_LLM_* values).
# Any OpenAI-compatible chat endpoint works. DeepSeek turns thinking mode on
# by default for its current models, which makes every call several times
# slower and rejects a named tool_choice: keep it disabled in production.
AGENT_LLM_MODEL=deepseek-v4-flash
AGENT_LLM_BASE_URL=https://api.deepseek.com/v1
AGENT_LLM_API_KEY=your-model-api-key
AGENT_LLM_THINKING=disabled
AGENT_V3_MODEL=
AGENT_V3_BASE_URL=
AGENT_V3_API_KEY=
AGENT_V3_THINKING=disabled

# Web search fallback is double-gated: the server flag here AND the request's
# allow_web must both be on before an agent reaches Tavily.
AGENT_V2_WEB_ENABLED=false
AGENT_V3_WEB_ENABLED=false

# Persistence. Relative paths resolve from the repository root; defaults are
# under data/ and are git-ignored. Leave empty for the defaults.
AGENT_V2_SESSION_DB=
AGENT_V2_USER_MEMORY=
AGENT_V2_INTENT_LEDGER=
AGENT_V2_CAPABILITY_LEDGER=
AGENT_V2_SUBAGENT_LEDGER=
AGENT_V2_QUALITY_LEDGER=
AGENT_V3_DATA_DIR=
AGENT_V3_ARCHIVE_DB=
WEB_ARCHIVE_DB=
WEB_LAB_DB=
WEB_PERSONAS_DB=

# Telegram: whether /ask allows web search when the message carries no flag.
TELEGRAM_WEB_DEFAULT=false

# Billing channel label for processes that are not a web or Telegram request
# (scheduler, streamer, scripts): web | telegram | background | unknown.
USAGE_CHANNEL=background

# SEC EDGAR also accepts a full User-Agent string; EDGAR_IDENTITY above is enough.
SEC_USER_AGENT=
